# ARA v1.0 Infrastructure Environment Variables
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=ara_super_secret_jwt_key_sprint_1_infrastructure

# PostgreSQL Database Configuration
POSTGRES_USER=ara
POSTGRES_PASSWORD=ara_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ara_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# MinIO Storage Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# Vector Embeddings
VECTOR_EMBEDDING_DIM=1536
VECTOR_DISTANCE_METRIC=cosine
